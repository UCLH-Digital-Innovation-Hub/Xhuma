// Xhuma dm+d Cache Warmer Missed-Success & Release-Freshness Watchdog
//
// Evaluates target-local Container Apps Job console logs for the weekly Monday dm+d warmer.
// Target Job: ${app_service_name}-dmd-warm
// Recurrence: Monday 05:00 UK local time.
// Headroom: Evaluates during Monday operating window (06:00 UTC through Tuesday 04:00 UTC).
//
// Alert Condition (Threshold > 0):
// 1. Missed Success: No successful warm_succeeded event in the operating window (last 24h).
// 2. Release Freshness Failure: warm_succeeded event present, but release did not advance from previous release.

let job_name = "${app_service_name}-dmd-warm";
let current_day = floor(dayofweek(now()) / 1d, 1);
let current_hour = hourofday(now());
// Monday operating window starts at 06:00 UTC (allowing execution headroom) and runs through Tuesday 04:00 UTC
let is_active_window = (current_day == 1 and current_hour >= 6) or (current_day == 2 and current_hour < 4);
let events = union isfuzzy=true (ContainerAppConsoleLogs_CL)
| where ContainerJobName_s == job_name
| where TimeGenerated > ago(24h)
| where Log_s has "warm_succeeded"
| extend raw_json = extract(@"dmd_cache_event\s+({.*})", 1, Log_s)
| extend evt = parse_json(raw_json)
| where evt.event == "warm_succeeded"
| project TimeGenerated,
          release = tostring(evt.release),
          previous_release = tostring(evt.previous_release),
          release_advanced = tobool(evt.release_advanced);
let total_succeeded = toscalar(events | count);
let advanced_count = toscalar(events | where release_advanced == true | count);
print
    Alert = "dm+d cache warm failure in Monday operating window",
    WindowActive = is_active_window,
    TotalSucceededEvents = total_succeeded,
    AdvancedEvents = advanced_count,
    Reason = iff(total_succeeded == 0, "Missed success: no warm_succeeded event in last 24h", "Stale release: warm succeeded but release did not advance")
| where WindowActive and AdvancedEvents == 0
